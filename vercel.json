{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api).*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/trigger",
      "schedule": "0 9 * * *"
    }
  ]
}
