{
  "name": "autonomous-ai-creator",
  "version": "1.0.0",
  "description": "Autonomous AI Creator agent hosted on Vercel with direct X (Twitter) and LinkedIn publishing",
  "main": "dist/index.js",
  "scripts": {
    "build:frontend": "vite build",
    "build:backend": "tsc",
    "build": "vite build && tsc",
    "start": "node dist/src/index.js",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "@google/genai": "^0.15.0",
    "@libsql/client": "^0.17.4",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "twitter-api-v2": "^1.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "vercel": "^39.2.0",
    "vite": "^8.2.1"
  }
}
