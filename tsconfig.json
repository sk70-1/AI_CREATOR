{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/agent/**/*",
    "src/db/**/*",
    "src/publishers/**/*",
    "src/routes/**/*",
    "src/app.ts",
    "src/index.ts",
    "api/**/*"
  ]
}
